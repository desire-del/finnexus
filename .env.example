# APPLICATION

ENVIRONMENT=dev
LOG_LEVEL=DEBUG
JSON_LOGGING=false



# DATABASE

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/finexus



# EMBEDDINGS

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=your_openai_api_key_here


# LLM

LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://localhost:11434


# OBSERVABILITY

OBSERVABILITY_PROVIDER=phoenix

# PHOENIX

PHOENIX_ENDPOINT=http://localhost:6060
PHOENIX_PROJECT_NAME=finexus


# LANGFUSE

LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=