# APPLICATION

ENVIRONMENT=dev
LOG_LEVEL=DEBUG
JSON_LOGGING=false



# DATABASE

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/finexus

# EDGAR API
EDGAR_IDENTITY="Ton Nom ton.email@example.com"



# EMBEDDINGS

EMBEDDING_PROVIDER=huggingface
EMBEDDING_OPENAI_MODEL_NAME=text-embedding-3-small
EMBEDDING_OPENAI_DIMENSION=1536
EMBEDDING_HUGGINGFACE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_HUGGINGFACE_DIMENSION=384
EMBEDDING_OLLAMA_MODEL_NAME=nomic-embed-text
EMBEDDING_OLLAMA_DIMENSION=768
EMBEDDING_API_KEY=your_openai_api_key_here
EMBEDDING_BASE_URL=


# LLM

LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=
LLM_TEMPERATURE=0.0


# RERANKER (evaluation only; not wired into production queries)

RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512


# OBSERVABILITY

OBSERVABILITY_PROVIDER=phoenix
OBSERVABILITY_CAPTURE_CONTENT=false
OBSERVABILITY_INSTRUMENT_LANGCHAIN=false
OBSERVABILITY_INSTRUMENT_OPENAI=true
OBSERVABILITY_SHUTDOWN_TIMEOUT_SECONDS=5

# PHOENIX

PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=finexus
PHOENIX_API_KEY=
PHOENIX_BATCH=true
